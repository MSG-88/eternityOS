// Eternity 08 Plymouth theme (script plugin)

Window.SetBackgroundTopColor(0.027, 0.043, 0.078);     // #070B14
Window.SetBackgroundBottomColor(0.051, 0.075, 0.125);  // #0D1320

screen.w = Window.GetWidth();
screen.h = Window.GetHeight();

logo.image = Image("logo.png");
if (logo.image.GetWidth() > screen.w * 0.6) {
    logo.image = logo.image.Scale(screen.w * 0.6, logo.image.GetHeight() * (screen.w * 0.6) / logo.image.GetWidth());
}
logo.sprite = Sprite(logo.image);
logo.x = screen.w / 2 - logo.image.GetWidth() / 2;
logo.y = screen.h / 2 - logo.image.GetHeight() / 2 - 30;
logo.sprite.SetPosition(logo.x, logo.y, 1);

bar.bg = Image("progress-bg.png");
bar.fg_full = Image("progress-fg.png");
bar.x = screen.w / 2 - bar.bg.GetWidth() / 2;
bar.y = logo.y + logo.image.GetHeight() + 36;
bar.bg_sprite = Sprite(bar.bg);
bar.bg_sprite.SetPosition(bar.x, bar.y, 2);
bar.fg_sprite = Sprite();
bar.fg_sprite.SetPosition(bar.x, bar.y, 3);
bar.width = 0;

fun progress_callback(duration, progress) {
    w = Math.Int(bar.fg_full.GetWidth() * progress);
    if (w < 2) w = 2;
    if (w != bar.width) {
        bar.width = w;
        bar.fg_sprite.SetImage(bar.fg_full.Scale(w, bar.fg_full.GetHeight()));
    }
}
Plymouth.SetBootProgressFunction(progress_callback);

// Idle pulse of the bar while waiting (shutdown, no progress events)
pulse.t = 0;
fun refresh_callback() {
    pulse.t += 1;
    if (Plymouth.GetMode() == "shutdown" || Plymouth.GetMode() == "reboot") {
        w = Math.Int(bar.fg_full.GetWidth() * (0.5 + 0.5 * Math.Sin(pulse.t / 20)));
        if (w < 2) w = 2;
        bar.fg_sprite.SetImage(bar.fg_full.Scale(w, bar.fg_full.GetHeight()));
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

// Status / password messages below the bar
message.sprite = Sprite();
message.sprite.SetPosition(0, bar.y + 40, 4);
fun message_callback(text) {
    img = Image.Text(text, 0.49, 0.55, 0.63, 1, "Sans 12");
    message.sprite.SetImage(img);
    message.sprite.SetX(screen.w / 2 - img.GetWidth() / 2);
}
Plymouth.SetDisplayMessageFunction(message_callback);

fun password_callback(prompt, bullets) {
    txt = "";
    for (i = 0; i < bullets; i++) txt += "•";
    img = Image.Text(prompt + "  " + txt, 0.9, 0.95, 1.0, 1, "Sans 12");
    message.sprite.SetImage(img);
    message.sprite.SetX(screen.w / 2 - img.GetWidth() / 2);
}
Plymouth.SetDisplayPasswordFunction(password_callback);

fun normal_callback() {
    message.sprite.SetImage(Image.Text("", 0, 0, 0));
}
Plymouth.SetDisplayNormalFunction(normal_callback);

fun quit_callback() {
    bar.fg_sprite.SetImage(bar.fg_full);
}
Plymouth.SetQuitFunction(quit_callback);
