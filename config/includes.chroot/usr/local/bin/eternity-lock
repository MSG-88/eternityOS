#!/bin/sh
# Lock the session: asks eternity-daemon (the shell raises the lock scene); falls back to loginctl.
if /usr/bin/python3 -c 'import sys; sys.path.insert(0, "/usr/lib/eternity/py"); from eternity import daemon; daemon.Client().call("session.lock")' 2>/dev/null; then
    exit 0
fi
exec loginctl lock-session
