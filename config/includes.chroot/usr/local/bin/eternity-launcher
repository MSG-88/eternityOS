#!/bin/sh
# Eternity 08 launcher. In the Eternity session (daemon socket present) it raises the shell's
# launcher ring; otherwise the GTK launcher window (XFCE) opens.
SOCK="${ETERNITY_SOCK:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/eternity/daemon.sock}"
if [ -S "$SOCK" ] && [ "$1" != "--gtk" ]; then
    exec /usr/bin/python3 -c 'import sys; sys.path.insert(0, "/usr/lib/eternity/py"); from eternity import daemon; daemon.Client().call("launcher.show")'
fi
exec /usr/bin/python3 -c 'import sys; sys.path.insert(0, "/usr/lib/eternity/py"); from eternity.ui import launcher as m; sys.exit(m.main())' "$@"
