#!/bin/sh
# The Eternity greeter process run by greetd under cage: lists the accounts for the scene and
# runs the Quickshell greeter config. If the scene cannot start, the text greeter (agreety)
# takes over so the machine never shows a black screen.
RUN=/run/eternity-greeter
mkdir -p "$RUN" 2>/dev/null
getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /nologin|false/ { printf "%s%s", (n++ ? "," : "["), "{\"name\":\"" $1 "\",\"full\":\"" $5 "\"}" } END { print (n ? "]" : "[]") }' > "$RUN/users.json" 2>/dev/null
export QT_QPA_PLATFORM=wayland
export ETERNITY_GREETER_USERS="$RUN/users.json"
quickshell -p /usr/share/eternity/greeter/shell.qml
rc=$?
[ "$rc" = 0 ] && exit 0
echo "eternity-greeter: the scene exited with $rc; falling back to the text greeter" >&2
exec agreety --cmd eternity-session
