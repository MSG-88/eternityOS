#!/bin/sh
# The Eternity greeter process run by greetd (as _greetd, on its VT). Writes the account list for
# the scene, runs the scene under cage, and when cage or the scene cannot run (missing binaries,
# a broken config, an exit within 5 s) runs the text greeter on the VT instead, so the machine
# never shows a black screen. greetd.service also falls back to lightdm when this exits non-zero.
RUN=${XDG_RUNTIME_DIR:-/run/eternity-greeter}
[ -d "$RUN" ] || RUN=/run/eternity-greeter
mkdir -p "$RUN" 2>/dev/null
# names only (no GECOS: nothing personal before login, and nothing to escape)
getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /nologin|false/ { printf "%s\"%s\"", (n++ ? "," : "["), $1 } END { print (n ? "]" : "[]") }' > "$RUN/users.json" 2>/dev/null
export ETERNITY_GREETER_USERS="$RUN/users.json"
if command -v cage >/dev/null 2>&1 && command -v quickshell >/dev/null 2>&1 && [ -s /usr/share/eternity/greeter/shell.qml ]; then
    start=$(date +%s)
    cage -s -- eternity-greeter-scene
    rc=$?
    [ "$rc" = 0 ] && [ $(( $(date +%s) - start )) -ge 5 ] && exit 0
    echo "eternity-greeter: the scene exited with $rc after $(( $(date +%s) - start )) s; text greeter instead" >&2
else
    echo "eternity-greeter: cage, quickshell or the scene is missing; text greeter instead" >&2
fi
exec agreety --cmd eternity-session
