#!/bin/sh
# Installer branding: drop the Debian-branded launcher and autostart shipped by calamares-settings-debian.
set -e
rm -f /etc/xdg/autostart/calamares-desktop-icon.desktop
rm -f /usr/share/applications/calamares-install-debian.desktop
rm -f /usr/share/applications/calamares.desktop
chmod 755 /usr/lib/eternity/post-install.sh /usr/lib/eternity/desktop-icons.sh /usr/local/bin/eternity-install
