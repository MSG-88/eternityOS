#!/bin/sh
# Boot theming: Plymouth default theme, GRUB distributor/theme for installed systems.
set -e

plymouth-set-default-theme -R eternity

# Boot-log lines for the splash (real facts, see /usr/lib/eternity/bootlog.sh)
chmod 755 /usr/lib/eternity/bootlog.sh
systemctl enable eternity-bootlog.service >/dev/null 2>&1 || true

if [ -f /etc/default/grub ]; then
    sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="Eternity 08"/' /etc/default/grub
    grep -q '^GRUB_DISTRIBUTOR=' /etc/default/grub || echo 'GRUB_DISTRIBUTOR="Eternity 08"' >> /etc/default/grub
fi

# The Debian GRUB background script must not override our theme on installed systems.
if [ -f /etc/grub.d/05_debian_theme ]; then
    chmod -x /etc/grub.d/05_debian_theme
fi

# fc-cache for the shipped fonts (used by Plymouth's text and the greeter)
fc-cache -f >/dev/null 2>&1 || true

# Debian's plymouth initramfs hook links /usr/share/fonts/Plymouth{,-monospace}.ttf to fc-match's
# defaults inside the initramfs only. Plymouth keeps whatever path it resolved there after it is
# moved to the real root, so the same links must exist here as well (build 13 drew boxes).
f=$(fc-match -f %{file} 2>/dev/null); [ -n "$f" ] && ln -sfn "$f" /usr/share/fonts/Plymouth.ttf || true
f=$(fc-match -f %{file} monospace 2>/dev/null); [ -n "$f" ] && ln -sfn "$f" /usr/share/fonts/Plymouth-monospace.ttf || true
chmod 755 /etc/initramfs-tools/hooks/eternity-fonts
