#!/bin/sh
# Eternity 08 live-build configuration. Invoked by `lb config` (via build.sh).
set -e

lb config noauto \
    --distribution trixie \
    --archive-areas "main contrib non-free non-free-firmware" \
    --backports true \
    --architectures amd64 \
    --linux-flavours amd64 \
    --binary-images iso-hybrid \
    --bootloaders "grub-pc,grub-efi" \
    --uefi-secure-boot enable \
    --debian-installer none \
    --iso-application "Eternity 08" \
    --iso-volume "ETERNITY08" \
    --iso-publisher "Eternity 08" \
    --iso-preparer "Eternity 08 build.sh" \
    --image-name eternity-08-0.1.0 \
    --bootappend-live "boot=live components quiet splash locales=en_US.UTF-8 username=eternity hostname=eternity live-config.noautologin" \
    --apt-recommends true \
    --cache-packages true \
    --firmware-chroot true \
    --firmware-binary true \
    --checksums sha256 \
    --zsync false \
    "${@}"
